# =============================================================================
# Переменные окружения публичного сайта
#
# Локально:
#   Windows:  copy .env.example .env.local
#   macOS/Linux:  cp .env.example .env.local
#
# Заполните .env.local реальными значениями. Файл .env.local не коммитьте в git.
# После изменения .env.local перезапустите: npm run dev
#
# Все переменные опциональны — у каждой есть значение по умолчанию в коде.
# =============================================================================

# --- Публичный URL сайта (canonical, sitemap, Open Graph) ---
# Локально можно оставить localhost.
# В production укажите боевой https-адрес, не localhost и не preview-URL Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp для кнопок заказа: только цифры, код страны без «+» ---
NEXT_PUBLIC_WHATSAPP_NUMBER=992888899311
